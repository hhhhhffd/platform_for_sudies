# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=judgeflow
POSTGRES_USER=judgeflow
POSTGRES_PASSWORD=your_secure_password_here

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=your_random_secret_key_here
# Base32 TOTP key (at least 32 characters). Add it to your authenticator app.
ORGANIZER_TOTP_SECRET=your_base32_totp_secret_here
FRONTEND_URL=http://localhost
UPLOAD_DIR=uploads
ENV=production

# ── Logging ───────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: "json" (прод, машиночитаемый) или "console" (dev, красивый)
LOG_FORMAT=json

# ── Cloudflare Tunnel ─────────────────────────────────────────
# Бесплатная ссылка (не нужен токен):
#   docker compose --profile tunnel up
# Кастомный домен — получи токен в Cloudflare Dashboard → Zero Trust → Networks → Tunnels:
#   docker compose --profile tunnel-token up
CLOUDFLARE_TUNNEL_TOKEN=
